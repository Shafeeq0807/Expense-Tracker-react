# Copy this file to server/.env and fill in your values.
# server/.env is git-ignored, so your password and secret stay off GitHub.

PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=expense_tracker

# A dedicated MySQL user is recommended (see the setup steps in README)
DB_USER=expense_app
DB_PASSWORD=change-me

# Long random string used to sign login tokens
JWT_SECRET=replace-with-a-long-random-string

# Frontend address allowed to call the API
CLIENT_ORIGIN=http://localhost:3000
